# ==========================================
# PYCHARM / JETBRAINS IDE
# ==========================================
# Ignora toda la carpeta .idea excepto los archivos de configuración compartidos si los hubiera
.idea/

# Si prefieres conservar diccionarios o configuraciones compartidas del equipo,
# descomenta las siguientes líneas pero mantén el resto de .idea oculto:
# !.idea/vcs.xml
# !.idea/runConfigurations/

# Archivos temporales de despliegue de PyCharm
*.iml
*.iws
*.ipr

# ==========================================
# ARCHIVOS DE ENTORNO Y SECRETOS (¡CRÍTICO!)
# ==========================================
# Nunca subas contraseñas, tokens de API o configuraciones locales
.env
.env.local
.env.*
.secrets
*.pem
*.key
